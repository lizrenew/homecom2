# 이 파일을 .env 로 복사한 뒤 실제 값을 넣으세요. (.env 는 git 에 올라가지 않습니다)
# Vercel 배포 시에는 프로젝트 Settings → Environment Variables 에 같은 이름으로 등록하세요.

# [필수] Supabase Postgres 연결 문자열 (Project Settings → Database → Connection string, Transaction pooler)
DATABASE_URL=postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:6543/postgres

# [선택] 로컬 서버 포트 (기본 3000)
# PORT=3000

# [필수] JWT 서명용 비밀키 (32자 이상 랜덤 문자열). 생성 예:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 바꾸면 기존 로그인 토큰이 모두 무효가 됩니다.
JWT_SECRET=

# [필수: 결제] 토스페이먼츠 주문서형(결제위젯) 연동 키 — 개발자센터 → API 키
# 테스트 키는 test_gck_ / test_gsk_ 로 시작합니다. 시크릿 키는 절대 클라이언트·GitHub 에 올리지 마세요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
